{
  "name": "form-js-designer",
  "version": "0.0.0",
  "private": true,
  "description": "form-js 기반 전문 화면 디자이너 (WYSIWYG, AI-driven, ko 1차)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "echo \"TODO: per-package build\" && exit 0",
    "test": "echo \"TODO: vitest\" && exit 0",
    "lint": "npm run lint:no-css-modules && npm run lint:single-preact && npm run lint:watermark-hash && npm run lint:watermark-scss",
    "lint:no-css-modules": "node scripts/ci/no-css-modules.mjs",
    "lint:single-preact": "node scripts/ci/assert-single-preact.mjs",
    "lint:watermark-hash": "node scripts/ci/watermark-hash.mjs",
    "lint:watermark-scss": "node scripts/ci/watermark-scss-lint.mjs",
    "lint:license": "node scripts/ci/license-gate.mjs",
    "license:check": "node scripts/ci/license-gate.mjs",
    "license:gen": "node scripts/ci/gen-third-party-licenses.mjs",
    "release:rc": "node scripts/ci/tag-rc.mjs",
    "test:ac-matrix": "node scripts/rc/run-ac-matrix.mjs",
    "test:rc": "npm run lint && npm run lint:license && npm run test:ac-matrix",
    "test:ci-scripts": "node --test scripts/ci/__tests__/watermark-scss-lint.test.mjs && node --test scripts/ci/__tests__/watermark-hash.test.mjs"
  },
  "dependencies": {
    "@bpmn-io/form-js-editor": "^1.21.2",
    "@bpmn-io/form-js-viewer": "^1.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "js-yaml": "^4.1.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "preact": "10.29.x"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongik-sv/form-js-designer.git"
  }
}
