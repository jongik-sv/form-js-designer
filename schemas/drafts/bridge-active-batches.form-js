      "id": "card-1",
      "padding": "md",
      "elevation": 1,
      "header": "Bridge",
      "headerTag": "h2",
      "layout": { "row": "row-1", "columns": 4, "height": 800 },
      "components": [
        { "type": "text", "id": "text-1", "text": "Enterprise SCM" },
        { "type": "separator", "id": "separator-1" },
        { "type": "text", "id": "text-2", "text": "**Batches**" },
        { "type": "text", "id": "text-3", "text": "Active" },
        { "type": "text", "id": "text-4", "text": "Sold" },
        { "type": "text", "id": "text-5", "text": "Distributors" },
        { "type": "text", "id": "text-6", "text": "Documentation" },
        { "type": "spacer", "id": "spacer-1", "height": 320 },
        { "type": "separator", "id": "separator-2" },
        { "type": "text", "id": "text-7", "text": "0xf39fd...82286" },
        { "type": "text", "id": "text-8", "text": "Producer" }
      ]
    },
    {
      "type": "card",
      "id": "card-2",
      "padding": "md",
      "elevation": 1,
      "header": "",
      "headerTag": "h3",
      "layout": { "row": "row-1", "columns": 12, "height": 800 },
      "components": [
        {
          "type": "text",
          "id": "text-9",
          "text": "## Active Batches (13)",
          "layout": { "row": "row-1", "columns": 10 }
        },
        {
          "type": "button",
          "id": "button-1",
          "label": "+ Produce New Batch",
          "action": "submit",
          "layout": { "row": "row-1", "columns": 6 }
        },
        {
          "type": "textfield",
          "id": "textfield-1",
          "key": "filters.search",
          "label": "Search",
          "description": "Search by name, ID, etc.",
          "layout": { "row": "row-2", "columns": 12 }
        },
        {
          "type": "select",
          "id": "select-1",
          "key": "filters.status",
          "label": "Status",
          "values": [
            { "label": "All statuses", "value": "all" },
            { "label": "Produced", "value": "produced" },
            { "label": "Picked up", "value": "pickedUp" },
            { "label": "Ready for pickup", "value": "ready" }
          ],
          "layout": { "row": "row-2", "columns": 4 }
        },
        {
          "type": "table",
          "id": "table-1",
          "label": "Batches",
          "rowCount": 10,
          "columns": [
            { "label": "Name", "key": "name" },
            { "label": "Product ID", "key": "productId" },
            { "label": "Price", "key": "price" },
            { "label": "Status", "key": "status" }
          ],
          "dataSource": "= [{name:\"Emerald Green Tea Leaves\",productId:\"#134239GGUW\",price:\"$44.10\",status:\"Produced\"}, {name:\"Dragon Fruit Powder\",productId:\"#4467KCCHY8Z\",price:\"$112.30\",status:\"Produced\"}, {name:\"Cold-Pressed Virgin Maruia Oil\",productId:\"#7813HGBWMM\",price:\"$124.00\",status:\"Ready for pickup\"}, {name:\"Organic Madagascar Vanilla Beans\",productId:\"#647K1ZWCCQ\",price:\"$165.00\",status:\"Produced\"}, {name:\"Artisanal Smoked Paprika\",productId:\"#91987YEDB\",price:\"$38.50\",status:\"Ready for pickup\"}, {name:\"Toasted Sesame Oil\",productId:\"#1398BFGROUT\",price:\"$89.95\",status:\"Ready for pickup\"}, {name:\"Biodegradable Bamboo Fiber\",productId:\"#284K1KH7CEE\",price:\"$62.40\",status:\"Produced\"}, {name:\"Cold-Pressed Chia Seed Oil\",productId:\"#5372D1LYKLH\",price:\"$198.00\",status:\"Picked up\"}, {name:\"Himalayan Pink Salt\",productId:\"#10804FT9MJJ\",price:\"$88.40\",status:\"Produced\"}, {name:\"Fermented Pea Protein\",productId:\"#37950CCCSF28\",price:\"$74.20\",status:\"Produced\"}]",
          "layout": { "row": "row-3", "columns": 16, "height": 520 }
        },
        {
          "type": "text",
          "id": "text-10",
          "text": "0 of 10 row(s) selected.",
          "layout": { "row": "row-4", "columns": 8 }
        },
        {
          "type": "button",
          "id": "button-2",
          "label": "Previous",
          "action": "reset",
          "layout": { "row": "row-4", "columns": 4 }
        },
        {
          "type": "button",
          "id": "button-3",
          "label": "Next",
          "action": "submit",
          "layout": { "row": "row-4", "columns": 4 }
        }
      ]
    }
  ]
