{
  "name": "@form-js-designer/designer-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Designer runtime: JSON deployment channels (static + API adapter) with boot validation",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./boot": "./src/boot/index.ts",
    "./watermark": "./src/watermark/index.ts"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:update": "playwright test --config playwright.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@form-js-designer/designer-core": "*",
    "@bpmn-io/form-js-viewer": "^1.21.2",
    "preact": "^10.19.3"
  },
  "dependencies": {
    "@form-js-designer/designer-components": "*",
    "@form-js-designer/designer-core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.16.10",
    "happy-dom": "^15.7.4",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
