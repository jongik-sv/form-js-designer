{
  "name": "@form-js-designer/designer-cli",
  "version": "0.0.0",
  "private": true,
  "description": "CLI for form-js designer: validate, import, and publish form schemas",
  "type": "module",
  "bin": {
    "designer-cli": "./bin/designer-cli.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.16.10",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
