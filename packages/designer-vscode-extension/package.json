{
  "name": "@form-js-designer/designer-vscode-extension",
  "displayName": "Form JS Designer",
  "version": "0.0.1",
  "private": true,
  "description": "VSCode extension for form-js schema designer — Markdown preview + Custom Editor",
  "publisher": "form-js-designer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown": {
      "markdownItPlugins": true,
      "previewScripts": [
        "./dist/webview/preview.js"
      ],
      "previewStyles": [
        "./media/form-js.css",
        "./media/form-js-base.css",
        "./media/form-js-block.css"
      ]
    }
  },
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node scripts/copy-css.mjs && node esbuild.config.mjs",
    "build:copy-css": "node scripts/copy-css.mjs",
    "build:bundle": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "../../node_modules/.bin/vitest run --config vitest.config.ts",
    "test:unit:watch": "../../node_modules/.bin/vitest --config vitest.config.ts",
    "test:coverage": "../../node_modules/.bin/vitest run --config vitest.config.ts --coverage",
    "test:e2e": "echo 'TODO: @vscode/test-electron'"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.16.10",
    "@vitest/coverage-v8": "^4.1.4",
    "markdown-it": "^14.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.4"
  }
}
